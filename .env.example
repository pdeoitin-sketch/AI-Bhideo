# AI-Bhideo video gateway — local secrets only. Copy to `.env` (git-ignored).
#
#   cp .env.example .env && npm run gateway
#
# Every key is optional: with no keys the studio still renders locally for
# free, and users can paste their own key in the Provider Access panel (BYOK).
# Only set the ones for providers you intend to call — an unused key is an
# unused liability.

# ---- Guardrails (applied server-side, not just in the UI) ------------------
# A single clip is refused above this estimate.
BHIDEO_MAX_CLIP_USD=0.50
# Total upstream spend allowed per month before the gateway refuses jobs.
BHIDEO_MONTHLY_BUDGET_USD=20
# Gateway mount path (used by the standalone server).
BHIDEO_GATEWAY_BASE_PATH=/api/video
PORT=8787

# ---- Free / cheap first ----------------------------------------------------
# Cloudflare Workers AI: 10,000 Neurons/day free, no card. Best "real model,
# no money" starting point. Token needs the `Workers AI: Read` permission.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# fal.ai — largest catalogue, usually the lowest per-second price.
# Create one at https://fal.ai/dashboard/keys
FAL_KEY=

# Replicate — clean async job API + webhooks.
REPLICATE_API_TOKEN=

# OpenRouter — one key for Veo / Kling / Seedance / Wan / Hailuo.
OPENROUTER_API_KEY=

# ---- First-party vendors ---------------------------------------------------
# Google Gemini API (Veo 3.1): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# MiniMax / Hailuo: https://platform.minimax.io
MINIMAX_API_KEY=

# Kling issues a short-lived HS256 JWT from this pair (signed by the gateway).
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Runway Dev: https://dev.runwayml.com
RUNWAYML_API_SECRET=

# Luma, Pika, BytePlus ModelArk (Seedance), Stability
LUMA_API_KEY=
PIKA_API_KEY=
BYTEPLUS_ARK_API_KEY=
STABILITY_API_KEY=

# Hugging Face — serverless / your own Inference Endpoint.
HF_TOKEN=

# OpenAI — KEPT FOR REFERENCE ONLY. The Videos API and sora-2 were retired on
# 2026-09-24, so calls will fail; the studio marks Sora routes as retired.
OPENAI_API_KEY=

# ---- Self-hosted / custom endpoint (template protocol) ---------------------
# Any REST service that submits a job and exposes a status URL. Point the
# catalogue's `custom` routes at it; see docs/VIDEO_PROVIDERS.md#custom.
BHIDEO_CUSTOM_VIDEO_URL=

# ---- Browser-side (optional) ----------------------------------------------
# Set this only in the dev tool, never in committed code: the studio reads
# VITE_BHIDEO_GATEWAY_URL at build time for a gateway on another origin.
VITE_BHIDEO_GATEWAY_URL=
